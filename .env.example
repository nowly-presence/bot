# Discord bot token
DISCORD_BOT_TOKEN=

# Discord application ID
DISCORD_APPLICATION_ID=

# Discord guild ID (for dev server commands)
DISCORD_GUILD_ID=

# Role claimed with a supporter key via /donator (defaults to the production Nowly server's role)
DISCORD_DONATOR_ROLE_ID=

# Role auto-added to new members on join (defaults to the production Nowly server's role)
DISCORD_MEMBER_ROLE_ID=

# Channel where the support ticket panel is posted (defaults to the production Nowly server's channel)
DISCORD_SUPPORT_CHANNEL_ID=

# Category new ticket channels are created under (defaults to the production Nowly server's category)
DISCORD_TICKET_CATEGORY_ID=

# Channel where welcome cards are posted on join. Welcome feature is disabled when unset.
DISCORD_WELCOME_CHANNEL_ID=
# ID du message de vérification dans le salon configuré
DISCORD_VERIFY_MESSAGE_ID=

# Channel where new X posts are posted
DISCORD_X_FEED_CHANNEL_ID=1553582467234136114

# Optional channel where new Bluesky posts are posted
DISCORD_BLUESKY_FEED_CHANNEL_ID=

# Private combined social feed URL with usernames=... and optionally bluesky=...
# XML RSS is the default format; include include_replies=false to exclude X replies
SOCIAL_FEED_URL=

# Private feed cache-clear endpoint and shared poll token
X_RSS_POLL_URL=
X_RSS_POLL_TOKEN=

# SQLite database file used to persist state (mount a volume here in production, e.g. /data/discord.sqlite)
DISCORD_DB_PATH=./.data/discord.sqlite

# Auto-register slash commands on startup
DISCORD_AUTO_REGISTER_COMMANDS=true

# API base URL for Nowly API
NOWLY_API_BASE_URL=http://localhost:3001

# App base URL for Nowly web
NOWLY_APP_BASE_URL=http://localhost:3000

# OpenAI API key for the "Fix with AI" ticket assistant (optional - feature degrades gracefully if unset)
OPENAI_API_KEY=
