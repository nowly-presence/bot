# Discord bot token
DISCORD_BOT_TOKEN=

# Discord application ID
DISCORD_APPLICATION_ID=

# Discord guild ID (for dev server commands)
DISCORD_GUILD_ID=

# Auto-register slash commands on startup
DISCORD_AUTO_REGISTER_COMMANDS=true

# API base URL for Nowly API
NOWLY_API_BASE_URL=http://localhost:3001

# App base URL for Nowly web
NOWLY_APP_BASE_URL=http://localhost:3000
